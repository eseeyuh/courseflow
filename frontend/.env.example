# CourseFlow web frontend configuration. Copy to `.env.local` (git-ignored).
#
# Every NEXT_PUBLIC_* value is inlined into the JavaScript sent to browsers at
# build time: it is PUBLIC. Never put a secret (database URL, password, API
# key) in a NEXT_PUBLIC_* variable. Changing it requires a rebuild/restart.

# Where the browser reaches the CourseFlow API. 127.0.0.1 (not localhost)
# matches the IPv4-only port published by docker-compose.yml.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
