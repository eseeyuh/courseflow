# CourseFlow environment configuration — SAFE PLACEHOLDERS ONLY.
# Copy to `.env` (git-ignored) and fill in real values locally.
# Never commit real credentials.

# --- Application ---------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ------------------------------------
# Used by docker-compose.yml to initialise the `db` container. Postgres only
# applies these when its data volume is FIRST created; changing them later
# requires recreating the volume. The password is a DEVELOPMENT-ONLY value
# that matches the docker-compose.yml fallback; use a real secret anywhere
# reachable from a network.
POSTGRES_USER=courseflow
POSTGRES_PASSWORD=courseflow-dev-only
POSTGRES_DB=courseflow
# Host ports published on 127.0.0.1 by docker-compose.yml.
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# Used by the API and tools running on the host (the API container gets its
# own URL from docker-compose.yml). Must match the values above. The async
# driver (asyncpg) is required. 127.0.0.1 avoids IPv6 `localhost` resolution.
DATABASE_URL=postgresql+asyncpg://courseflow:courseflow-dev-only@127.0.0.1:5432/courseflow
# Optional bounds (seconds) for new connections and health checks.
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_HEALTH_TIMEOUT_SECONDS=2
# Optional: tests default to DATABASE_URL with the database `courseflow_test`.
# TEST_DATABASE_URL=postgresql+asyncpg://courseflow:courseflow-dev-only@127.0.0.1:5432/courseflow_test

# --- Nebius Token Factory (OpenAI-compatible API) ------------------------
# Leave NEBIUS_API_KEY empty to run without AI; set it only in your local .env.
# Model IDs were verified against the live catalog on the date recorded in
# docs/experiments/model-catalog.md; re-verify before changing them.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model roles (see docs/decisions/ADR-005-ai-provider-boundary.md).
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_STRONG=nvidia/nemotron-3-super-120b-a12b
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# Optional reliability bounds (defaults shown).
# AI_REQUEST_TIMEOUT_SECONDS=60
# AI_MAX_ATTEMPTS=3
# AI_BACKOFF_BASE_SECONDS=1
# AI_BACKOFF_MAX_SECONDS=20
# AI_MAX_REPAIR_ATTEMPTS=1
# AI_MAX_OUTPUT_TOKENS=4096

# --- API: browser access (CORS) ------------------------------------------
# Comma-separated browser origins allowed to read API responses: exact
# scheme://host:port, no trailing slash, never "*". Must match the address
# you open the frontend at.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ------------------------------------------------------------
# Next.js reads its own env files from frontend/; see frontend/.env.example.
