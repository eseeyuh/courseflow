# CourseFlow environment configuration — SAFE PLACEHOLDERS ONLY.
# Copy to `.env` (git-ignored) and fill in real values locally.
# Never commit real credentials.

# --- Application ---------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ------------------------------------
DATABASE_URL=postgresql+psycopg://courseflow:change-me@localhost:5432/courseflow

# --- Nebius Token Factory (OpenAI-compatible API) ------------------------
# Base URL and model IDs must be verified against the live Token Factory
# model catalog before use; the values below are placeholders.
NEBIUS_API_KEY=replace-with-your-key
NEBIUS_BASE_URL=https://replace-with-token-factory-base-url/v1

# Model roles (see docs/architecture/system-context.md).
MODEL_FAST=replace-with-verified-nemotron-model-id
MODEL_STRONG=replace-with-verified-nemotron-model-id
EMBEDDING_MODEL=replace-with-verified-embedding-model-id

# --- Frontend ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
