# Optional settings for infra/demo/compose.yml — SAFE PLACEHOLDERS ONLY.
# Copy to infra/demo/.env (git-ignored) or export them. The defaults run the
# demo on this machine at http://localhost:3000 with the API on :8000.

# Database password (the database is not published outside Compose). Use a
# real secret on any shared server.
DEMO_DB_PASSWORD=courseflow-demo-only

# Where the ports are published: 127.0.0.1 locally; 0.0.0.0 on a server
# (behind HTTPS on anything public).
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000

# The URL people open, exactly (scheme://host[:port], no trailing slash): the
# API's only allowed CORS origin.
WEB_ORIGIN=http://localhost:3000
# The URL the browser uses to reach the API. Compiled into the web image:
# rebuild (--build) after changing it.
API_PUBLIC_URL=http://127.0.0.1:8000
