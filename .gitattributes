# Normalise all text files to LF in the repository and working tree.
# Development happens on Windows; Docker, CI and deployment run on Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary formats (demo course material and assets).
*.pdf  binary
*.docx binary
*.pptx binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
